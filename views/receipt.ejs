<!doctype html>
<html lang="bs">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Priznanica <%= r.number %> — <%= settings.school_name %></title>
<link rel="stylesheet" href="/style.css">
<style>
  @page { size: A5; margin: 12mm; }
  body { background: #e9ebef; }
  .slip { position: relative; background: #fff; max-width: 148mm; margin: 20px auto; padding: 14mm 12mm; box-shadow: 0 2px 12px rgba(0,0,0,.08); color: #111; font: 11pt/1.5 Calibri, Carlito, "Segoe UI", Arial, sans-serif; overflow: hidden; }
  .slip-head { display: flex; align-items: center; gap: 12px; border-bottom: 2px solid #111; padding-bottom: 10px; }
  .slip-head img { height: 54px; }
  .slip-head .s1 { font-weight: 700; font-size: 12.5pt; }
  .slip-head .s2 { color: #555; font-size: 10pt; }
  .slip-title { display: flex; justify-content: space-between; align-items: baseline; margin: 14px 0 10px; gap: 10px; flex-wrap: wrap; }
  .slip-title h1 { font-size: 15pt; letter-spacing: .04em; }
  .slip-title .no { font-size: 12pt; font-weight: 700; }
  .meta { display: grid; grid-template-columns: auto 1fr; gap: 2px 14px; margin-bottom: 12px; }
  .meta dt { color: #555; }
  .meta dd { margin: 0; font-weight: 600; }
  .slip table { width: 100%; border-collapse: collapse; font-size: 10.5pt; }
  .slip th, .slip td { border-bottom: 1px solid #ccc; padding: 5px 4px; text-align: left; background: none; white-space: normal; }
  .slip th { color: #555; font-weight: 600; font-size: 9.5pt; }
  .slip .r { text-align: right; white-space: nowrap; }
  .slip .stu td { font-weight: 700; padding-top: 9px; border-bottom: 0; }
  .slip tfoot td { border-top: 2px solid #111; border-bottom: 0; font-weight: 700; font-size: 12pt; padding-top: 8px; }
  .sign { display: flex; justify-content: space-between; margin-top: 28px; gap: 20px; font-size: 10pt; color: #555; }
  .sign div { flex: 1; border-top: 1px solid #111; padding-top: 4px; text-align: center; }
  .void-stamp { position: absolute; top: 38%; left: 50%; transform: translate(-50%, -50%) rotate(-18deg); border: 4px solid #b42318; color: #b42318; font-size: 28pt; font-weight: 800; padding: 4px 18px; letter-spacing: .1em; opacity: .75; pointer-events: none; }
  .void-note { margin-top: 12px; padding: 8px 10px; border: 1px solid #f3c7c2; background: #fff6f5; color: #912018; font-size: 10pt; border-radius: 6px; }
  .print-bar { position: sticky; top: 0; z-index: 5; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; padding: 12px; background: #fff; border-bottom: 1px solid var(--border); }
  .btn-wa { background: #1f9d55; border-color: #1f9d55; color: #fff; }
  .btn-wa .icon { color: #fff; }
  @media print { body { background: #fff; } .slip { margin: 0; box-shadow: none; padding: 0; max-width: none; } .print-bar { display: none; } }
  @media (max-width: 640px) { .slip { margin: 0; padding: 18px; } .print-bar .btn { flex: 1 1 40%; } }
</style>
</head>
<body>
<div class="print-bar">
  <button class="btn btn-primary" onclick="window.print()"><%- h.icon('printer') %>Štampaj</button>
  <% if (phone) { %><a class="btn btn-wa" href="https://wa.me/<%= phone %>?text=<%= encodeURIComponent(text) %>" target="_blank" rel="noopener"><%- h.icon('message-circle') %>WhatsApp</a><% } %>
  <button class="btn" type="button" data-share="<%= text %>"><%- h.icon('share-2') %>Pošalji / kopiraj</button>
  <a class="btn" href="javascript:history.back()"><%- h.icon('arrow-left') %>Nazad</a>
</div>

<div class="slip">
  <% if (r.voided) { %><div class="void-stamp">STORNIRANO</div><% } %>
  <div class="slip-head">
    <img src="/brand/logo-600.png" alt="">
    <div><div class="s1"><%= settings.school_name %></div><div class="s2">Evidencija članarine</div></div>
  </div>

  <div class="slip-title"><h1>PRIZNANICA</h1><span class="no">br. <%= r.number %></span></div>

  <dl class="meta">
    <dt>Datum uplate</dt><dd><%= h.formatDate(r.paid_on) %></dd>
    <% if (r.payer) { %><dt>Uplatio/la</dt><dd><%= r.payer %></dd><% } %>
    <dt>Način plaćanja</dt><dd><%= h.METHODS[r.method] || r.method %></dd>
  </dl>

  <table>
    <thead><tr><th>Članarina za</th><th class="r">Iznos (<%= settings.currency %>)</th></tr></thead>
    <tbody>
    <% for (const g of byStudent) { %>
      <tr class="stu"><td colspan="2"><%= g.student %><%= g.class_name ? ' · ' + g.class_name : '' %></td></tr>
      <% for (const l of g.lines) { %><tr><td><%= h.periodLabel(l.period).replace(/\.$/, '') %></td><td class="r"><%= h.amount(l.amount) %></td></tr><% } %>
    <% } %>
    </tbody>
    <tfoot><tr><td>Ukupno uplaćeno</td><td class="r"><%= h.money(r.total, settings.currency) %></td></tr></tfoot>
  </table>

  <% if (r.voided) { %><div class="void-note"><strong>Stornirano.</strong> <%= r.void_note %></div><% } %>

  <div class="sign"><div>Uplatio/la</div><div>Primio/la: <%= r.created_by_name %></div></div>
  <p class="small" style="color:#777;margin-top:14px">Izdato <%= h.formatDate(r.created_at) %> u <%= r.created_at.slice(11, 16) %>.</p>
</div>
<script src="/app.js"></script>
</body>
</html>
